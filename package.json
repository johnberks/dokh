{
  "name": "dokh",
  "version": "0.1.0",
  "private": true,
  "main": "expo-router/entry",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "start": "expo start",
    "ios": "expo start --ios",
    "android": "expo start --android",
    "typecheck": "npm run generate:routes --silent && tsc --noEmit",
    "check": "biome check .",
    "check:fix": "biome check --write .",
    "test": "jest",
    "test:watch": "jest --watch",
    "sync:agents": "node scripts/sync-agents.mjs",
    "check:agents": "node scripts/sync-agents.mjs --check",
    "generate:routes": "node scripts/generate-route-types.mjs",
    "supabase:start": "SUPABASE_TELEMETRY_DISABLED=1 supabase start",
    "supabase:status": "SUPABASE_TELEMETRY_DISABLED=1 supabase status",
    "supabase:reset": "SUPABASE_TELEMETRY_DISABLED=1 supabase db reset --local",
    "test:db": "bash scripts/test-migration-3.2.sh && bash scripts/test-migration-3.3.sh && bash scripts/test-migration-3.4.sh && bash scripts/test-migration-3.5.sh",
    "check:db-types": "SUPABASE_TELEMETRY_DISABLED=1 supabase gen types typescript --local --schema public | biome format --stdin-file-path src/data/database.types.ts | diff -u src/data/database.types.ts -"
  },
  "dependencies": {
    "@expo-google-fonts/archivo": "^0.4.2",
    "@expo-google-fonts/ibm-plex-mono": "^0.4.1",
    "@expo-google-fonts/unbounded": "^0.4.1",
    "@hookform/resolvers": "^5.9.1",
    "@react-native-community/netinfo": "12.0.1",
    "@tanstack/react-query": "^5.103.2",
    "date-fns": "^4.4.0",
    "expo": "~57.0.24",
    "expo-constants": "~57.0.19",
    "expo-font": "~57.0.4",
    "expo-linking": "~57.0.10",
    "expo-localization": "~57.0.2",
    "expo-router": "~57.0.22",
    "expo-splash-screen": "~57.0.9",
    "expo-status-bar": "~57.0.1",
    "expo-system-ui": "~57.0.4",
    "i18next": "^26.4.2",
    "lucide-react-native": "^1.47.0",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "react-hook-form": "^7.88.0",
    "react-i18next": "^17.0.15",
    "react-native": "0.86.3",
    "react-native-gesture-handler": "~2.32.0",
    "react-native-reanimated": "4.5.1",
    "react-native-safe-area-context": "~5.7.0",
    "react-native-screens": "~4.26.0",
    "react-native-svg": "15.15.4",
    "react-native-worklets": "0.10.1",
    "zod": "^4.6.5",
    "zustand": "^5.0.15"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.14",
    "@testing-library/react-native": "^14.0.1",
    "@types/jest": "29.5.14",
    "@types/node": "^22.20.4",
    "@types/react": "~19.2.2",
    "jest": "~29.7.0",
    "jest-expo": "~57.0.5",
    "supabase": "^2.113.0",
    "typescript": "~6.0.3"
  },
  "jest": {
    "preset": "jest-expo",
    "moduleNameMapper": {
      "^@/(.*)$": "<rootDir>/src/$1",
      "^lucide-react-native/icons/(.*)$": "<rootDir>/node_modules/lucide-react-native/dist/cjs/icons/$1.js",
      "^lucide-react-native$": "<rootDir>/node_modules/lucide-react-native/dist/cjs/lucide-react-native.js"
    },
    "transformIgnorePatterns": [
      "node_modules/(?!((jest-)?react-native|@react-native(-community)?)|expo(nent)?|@expo(nent)?/.*|@expo-google-fonts/.*|react-navigation|@react-navigation/.*|standard-navigation|lucide-react-native|@sentry/react-native|native-base|react-native-svg)"
    ],
    "setupFiles": [
      "<rootDir>/src/test/env.setup.ts",
      "<rootDir>/src/test/native-mocks.setup.ts"
    ]
  }
}
