{
  "expo": {
    "name": "DOKH",
    "slug": "dokh",
    "version": "0.1.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "dokh",
    "userInterfaceStyle": "light",
    "ios": {
      "bundleIdentifier": "com.dokh.app",
      "supportsTablet": false
    },
    "android": {
      "package": "com.dokh.app",
      "adaptiveIcon": {
        "backgroundColor": "#10160F",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#10160F",
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 76
        }
      ],
      "expo-font",
      "expo-status-bar",
      "expo-localization",
      "expo-secure-store",
      "@react-native-community/datetimepicker"
    ],
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "285cce47-d906-40fc-a6ea-168a3dd63919"
      }
    },
    "owner": "jberks",
    "runtimeVersion": {
      "policy": "appVersion"
    },
    "updates": {
      "url": "https://u.expo.dev/285cce47-d906-40fc-a6ea-168a3dd63919"
    }
  }
}
