# Copie para .env.local (ignorado pelo Git) e preencha. Nunca commitar valores reais.
# Somente variáveis públicas por natureza podem usar EXPO_PUBLIC_ (vão para o bundle).
# Após alterar, reinicie o Metro com: npx expo start --clear

# local | preview | production
EXPO_PUBLIC_APP_ENV=local

# Supabase local: valores exibidos por `npx supabase status` (tarefa 3.1).
# Simulador iOS usa 127.0.0.1; emulador Android usa 10.0.2.2; celular físico usa o IP da máquina na rede.
EXPO_PUBLIC_SUPABASE_URL=
EXPO_PUBLIC_SUPABASE_ANON_KEY=

# Opcionais até as fases correspondentes (13: observabilidade, 5: billing).
EXPO_PUBLIC_POSTHOG_KEY=
EXPO_PUBLIC_POSTHOG_HOST=
EXPO_PUBLIC_SENTRY_DSN=
EXPO_PUBLIC_REVENUECAT_IOS_API_KEY=
EXPO_PUBLIC_REVENUECAT_ANDROID_API_KEY=

# ---------------------------------------------------------------------------
# SOMENTE SERVIDOR/CI — nunca neste arquivo com valor, nunca com EXPO_PUBLIC_.
# Ficam em EAS Environments, Supabase secrets e GitHub secrets:
#   SUPABASE_SERVICE_ROLE_KEY, RESEND_API_KEY, REVENUECAT_WEBHOOK_AUTH_TOKEN,
#   SENTRY_AUTH_TOKEN, EXPO_TOKEN
